data/*.db
data/*.json
projects/*.aidub
projects/*.json
*.mp4
*.mp3
*.wav
*.mkv
*.avi

# Node.js Update Server dependencies & large binary downloads
server/node_modules/
server/.env
server/public/downloads/*.exe

# IDE & OS files
.vscode/
.idea/
Thumbs.db
.DS_Store
